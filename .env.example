# Copy to .env to enable accounts. Without these the app still builds and runs
# exactly as it always has — it just has no sign-in.
#
# Both of these are meant to be public: the publishable key ships inside the
# JavaScript bundle, and is safe there *because* every table has row-level
# security, so it can only ever reach the signed-in user's own rows.
#
# The secret / service_role key bypasses row-level security completely. It has
# no use in this app, must never appear in this file, and must never be
# committed.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
